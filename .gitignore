# Secrets
.env

# Runtime state (machine-specific Metabase IDs)
scripts/state.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
bin/windows/*.log
*.egg-info/

# Metabase internal DB (never commit)
metabase.db/
metabase_db/

# OS
.DS_Store
Thumbs.db

# Root exports/ (screenshots staging area) — track only .gitkeep
exports/*.json
exports/*.csv
exports/*.png
!exports/.gitkeep

# metabase-config/exports/ — COMMITTED intentionally for version control
# These JSON files allow recreating Metabase config on a new machine via:
#   python scripts/05_import_config.py  (or: make import)
# To stop tracking, uncomment the line below:
# metabase-config/exports/
