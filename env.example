# ============================================================
# Northwind Analytics — Environment Variables
# Copy thành .env rồi sửa
# ============================================================

TZ=Asia/Ho_Chi_Minh
METABASE_PORT=3000

# PostgreSQL từ ETL repo (đọc các giá trị này từ ETL repo .env)
ETL_DW_HOST=etl_postgres       # Tên container trong Docker network
ETL_DW_PORT=5432
ETL_DW_DATABASE=northwind_dw
ETL_DW_USER=etl_user
ETL_DW_PASSWORD=etl_password

# Metabase admin (setup lần đầu qua wizard, không dùng env trực tiếp)
# Ghi lại để nhớ:
# METABASE_ADMIN_EMAIL=admin@etl.local
# METABASE_ADMIN_PASSWORD=admin
