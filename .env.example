# ============================================================
# Northwind Analytics — Environment Variables
# Copy thành .env rồi sửa
# ============================================================

TZ=Asia/Ho_Chi_Minh
METABASE_PORT=3000

# ── ETL Database connection ────────────────────────────────
# Các giá trị này dùng trong setup wizard của Metabase
# (KHÔNG inject vào container, chỉ làm reference cho bạn)
#
# Option A (shared network): host=etl_postgres
# Option B (host network):   host=host.docker.internal
#
# Giá trị mặc định khớp với ETL repo .env.example:

ETL_DW_HOST=etl_postgres
ETL_DW_PORT=5432
ETL_DW_DATABASE=northwind_dw
ETL_DW_USER=etl_user
ETL_DW_PASSWORD=etl_password
